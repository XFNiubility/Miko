{
  "mcpServers": {
    "marketplace_math": {
      "type": "stdio",
      "command": "node",
      "args": ["${PACKAGE_DIR}/server/math-server.js"],
      "env": {
        "MARKETPLACE_MATH_PRECISION": "4"
      }
    },
    "marketplace_context": {
      "type": "stdio",
      "command": "node",
      "args": ["${PACKAGE_DIR}/server/context-server.js", "--profile", "local-market"],
      "env": {
        "MARKETPLACE_CONTEXT_LABEL": "Local Marketplace",
        "MARKETPLACE_CONTEXT_MODE": "diagnostic"
      }
    }
  }
}
